{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-notes-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "first-notes",
      // 用 `npx wrangler d1 create first-notes` 建立；自己架的話換成自己的 database_id（不是密碼，可以進 git）
      "database_id": "7d738a3b-00e5-483d-916a-f2b822ee2b19",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
